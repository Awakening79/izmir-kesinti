<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode variant — reuses the same theme so the fullscreen
  and portrait settings apply identically in dark system mode.
  Copy to android/app/src/main/res/values-night/styles.xml
-->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0B4D7A</item>
        <item name="colorPrimaryDark">#083A5C</item>
        <item name="colorAccent">#0EA5E9</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#083A5C</item>
        <item name="android:navigationBarColor">#083A5C</item>
    </style>

    <style name="AppTheme.Launcher" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
