<?xml version="1.0" encoding="utf-8"?>
<!--
  Android styles override for İzmir Kesinti Takibi.
  Copy this file to android/app/src/main/res/values/styles.xml
  after running `npx cap add android`.
-->
<resources>
    <!-- Base application theme: fullscreen, no title bar, portrait only -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- App primary colour — matches the deep-blue header in the web app -->
        <item name="colorPrimary">#0B4D7A</item>
        <item name="colorPrimaryDark">#083A5C</item>
        <item name="colorAccent">#0EA5E9</item>

        <!-- Fullscreen: hides status bar and navigation bar -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Suppress system UI chrome -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Background matches splash / header colour while WebView loads -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">#083A5C</item>
        <item name="android:navigationBarColor">#083A5C</item>
    </style>

    <!-- Splash screen theme shown before WebView is ready -->
    <style name="AppTheme.Launcher" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
