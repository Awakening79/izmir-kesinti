<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova / PhoneGap config.xml
  ─────────────────────────────
  Alternative packaging config if you prefer Cordova over Capacitor.

  Build steps:
    1. npm install -g cordova
    2. cordova platform add android
    3. cordova build android              (debug APK)
    4. cordova build android --release    (release APK — needs signing)
-->
<widget
  id="com.izmir.kesintitakibi"
  version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:cdv="http://cordova.apache.org/ns/1.0"
>
  <name>İzmir Kesinti Takibi</name>
  <description>İzmir elektrik kesinti takip uygulaması — GDZ Elektrik</description>
  <author email="info@example.com">İzmir Kesinti</author>

  <!-- Entry point after Vite build -->
  <content src="index.html" />

  <!-- Cordova allow-list: permit the deployed API origin -->
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="mailto:*" />

  <!-- ── Global preferences ─────────────────────────────────────── -->
  <preference name="DisallowOverscroll" value="true" />
  <preference name="BackgroundColor" value="0xFF0B4D7A" />
  <preference name="SplashScreenDelay" value="2000" />

  <!-- ── Android platform ───────────────────────────────────────── -->
  <platform name="android">
    <!-- Portrait-only (Hochformat gesperrt) -->
    <preference name="Orientation" value="portrait" />

    <!-- True fullscreen — hides status bar and navigation bar -->
    <preference name="Fullscreen" value="true" />

    <!-- Splash screen dimensions (replace images under res/) -->
    <splash src="res/screen/android/splash-port-hdpi.png"   density="port-hdpi" />
    <splash src="res/screen/android/splash-port-xhdpi.png"  density="port-xhdpi" />
    <splash src="res/screen/android/splash-port-xxhdpi.png" density="port-xxhdpi" />

    <!-- App icon (replace images under res/) -->
    <icon src="res/icon/android/ldpi.png"    density="ldpi" />
    <icon src="res/icon/android/mdpi.png"    density="mdpi" />
    <icon src="res/icon/android/hdpi.png"    density="hdpi" />
    <icon src="res/icon/android/xhdpi.png"   density="xhdpi" />
    <icon src="res/icon/android/xxhdpi.png"  density="xxhdpi" />
    <icon src="res/icon/android/xxxhdpi.png" density="xxxhdpi" />
  </platform>
</widget>
